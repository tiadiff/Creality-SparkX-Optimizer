<Window x:Class="SparkXOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Creality Print 7.3 - Speed &amp; Stability Optimizer (SparkX)"
        Height="780" Width="1020"
        MinHeight="680" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#121214"
        Foreground="#FFFFFF"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Modern ScrollBar Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#18181C"/>
            <Setter Property="Width" Value="8"/>
        </Style>

        <!-- Modern Card Style -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#1C1C21"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#2A2A33"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- Modern CheckBox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E0E0E6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>

        <!-- Primary Action Button -->
        <Style x:Key="PrimaryBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#00D284"/>
            <Setter Property="Foreground" Value="#0E1B15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#00F097"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Secondary Action Button -->
        <Style x:Key="SecondaryBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#25252D"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderBrush" Value="#383845"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" 
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#30303A"/>
                    <Setter Property="BorderBrush" Value="#00D284"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Launch Button -->
        <Style x:Key="LaunchBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E88E5"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2196F3"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Status Metrics -->
            <RowDefinition Height="Auto"/>
            <!-- Optimization Controls -->
            <RowDefinition Height="Auto"/>
            <!-- Log Console -->
            <RowDefinition Height="*"/>
            <!-- Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="CREALITY PRINT 7.3" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <Border Background="#00D284" CornerRadius="4" Margin="10,0,0,0" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock Text="SPEED &amp; STABILITY OPTIMIZER" FontSize="11" FontWeight="Bold" Foreground="#0E1B15"/>
                    </Border>
                    <Border Background="#25252D" CornerRadius="4" Margin="8,0,0,0" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock Text="v1.0.0" FontSize="11" Foreground="#A0A0AB"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="Eliminates startup lag, fixes KLSIM kinematics crash, purges WebView2 junk &amp; optimizes memory."
                           FontSize="13" Foreground="#9E9EA8" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnRefresh" Content="🔄 Rescan System" Style="{StaticResource SecondaryBtnStyle}" Margin="0,0,8,0" Click="BtnRefresh_Click"/>
                <Button x:Name="BtnLaunch" Content="🚀 Launch Creality Print" Style="{StaticResource LaunchBtnStyle}" Click="BtnLaunch_Click"/>
            </StackPanel>
        </Grid>

        <!-- STATUS METRICS CARDS -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Process Status -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="APP STATUS" FontSize="11" FontWeight="SemiBold" Foreground="#858592"/>
                    <TextBlock x:Name="TxtAppStatus" Text="Checking..." FontSize="15" FontWeight="Bold" Foreground="#00D284" Margin="0,4,0,2"/>
                    <TextBlock x:Name="TxtAppPath" Text="C:\Program Files\..." FontSize="11" Foreground="#6C6C7A" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Startup Speed -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="4,0,4,0">
                <StackPanel>
                    <TextBlock Text="STARTUP SPEED" FontSize="11" FontWeight="SemiBold" Foreground="#858592"/>
                    <TextBlock x:Name="TxtStartupStatus" Text="Checking..." FontSize="15" FontWeight="Bold" Foreground="#FFB800" Margin="0,4,0,2"/>
                    <TextBlock x:Name="TxtStartupDetail" Text="Home Page Webview active" FontSize="11" Foreground="#6C6C7A"/>
                </StackPanel>
            </Border>

            <!-- Card 3: Slicer Stability -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="4,0,4,0">
                <StackPanel>
                    <TextBlock Text="SLICER STABILITY" FontSize="11" FontWeight="SemiBold" Foreground="#858592"/>
                    <TextBlock x:Name="TxtStabilityStatus" Text="Checking..." FontSize="15" FontWeight="Bold" Foreground="#FF4D4D" Margin="0,4,0,2"/>
                    <TextBlock x:Name="TxtStabilityDetail" Text="Kinematics divergence check" FontSize="11" Foreground="#6C6C7A"/>
                </StackPanel>
            </Border>

            <!-- Card 4: Junk Cache -->
            <Border Grid.Column="3" Style="{StaticResource CardStyle}" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="RECLAIMABLE JUNK" FontSize="11" FontWeight="SemiBold" Foreground="#858592"/>
                    <TextBlock x:Name="TxtJunkSize" Text="0 MB" FontSize="15" FontWeight="Bold" Foreground="#00D284" Margin="0,4,0,2"/>
                    <TextBlock x:Name="TxtJunkDetail" Text="WebView2 &amp; model cache" FontSize="11" Foreground="#6C6C7A"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- MAIN ACTION & TUNING PANEL -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Action Buttons -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnQuickOptimize" Grid.Column="0" Content="⚡ 1-CLICK FULL OPTIMIZATION" 
                            Style="{StaticResource PrimaryBtnStyle}" Click="BtnQuickOptimize_Click"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                        <Button x:Name="BtnCleanJunk" Content="🧹 Clean Junk Only" Style="{StaticResource SecondaryBtnStyle}" Margin="0,0,8,0" Click="BtnCleanJunk_Click"/>
                        <Button x:Name="BtnFixCrashes" Content="🛡 Fix Slicer Crashes" Style="{StaticResource SecondaryBtnStyle}" Margin="0,0,8,0" Click="BtnFixCrashes_Click"/>
                        <Button x:Name="BtnRestore" Content="↩ Restore Defaults" Style="{StaticResource SecondaryBtnStyle}" Click="BtnRestore_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtBackupInfo" Text="Backup: None yet" FontSize="11" Foreground="#787885" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>

                <!-- Detailed Options Checklist -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <CheckBox x:Name="ChkSkipHomePage" IsChecked="True" Content="Skip Chromium Home Page on boot (Opens directly to 3D slicing plate)"/>
                        <CheckBox x:Name="ChkFixKinematics" IsChecked="True" Content="Fix KLSIM Helical Arc &amp; xy_step_dist divergence (Stops 100% CPU lockups)"/>
                        <CheckBox x:Name="ChkDisableAutoCalc" IsChecked="True" Content="Disable Background Auto-Slicing race condition &amp; cancellation crashes"/>
                        <CheckBox x:Name="ChkMemOpt" IsChecked="True" Content="Enable 3D preview memory optimization (Prevents std::bad_alloc)"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <CheckBox x:Name="ChkPurgeJunk" IsChecked="True" Content="Purge orphaned WebView2 profile folders &amp; temp slice models"/>
                        <CheckBox x:Name="ChkDisableCloudSync" IsChecked="True" Content="Disable slow Creality Cloud auto-sync check on boot"/>
                        <CheckBox x:Name="ChkSkipSplashTips" IsChecked="True" Content="Disable Splash Screen &amp; Daily Tips popups"/>
                        <CheckBox x:Name="ChkHighGpu" IsChecked="True" Content="Force Dedicated High-Performance GPU (NVIDIA / AMD)"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- LIVE LOG CONSOLE -->
        <Border Grid.Row="3" Background="#16161A" CornerRadius="8" BorderBrush="#25252D" BorderThickness="1" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="ACTION LOG" FontSize="12" FontWeight="Bold" Foreground="#858592"/>
                        <TextBlock x:Name="TxtLogStatus" Text="• Ready" FontSize="12" Foreground="#00D284" Margin="6,0,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Clear" Background="Transparent" Foreground="#787885" BorderThickness="0" Cursor="Hand" Click="BtnClearLog_Click"/>
                </Grid>

                <TextBox x:Name="TxtConsole" Grid.Row="1"
                         Background="Transparent"
                         Foreground="#A0A0B0"
                         BorderThickness="0"
                         FontFamily="Consolas"
                         FontSize="12"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         AcceptsReturn="True"/>
            </Grid>
        </Border>

        <!-- FOOTER -->
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Creality-SparkX Suite • Open-source utility for Creality Print 7.3.1" FontSize="11" Foreground="#555562"/>
            <TextBlock Grid.Column="1" Text="Compatible with Windows 10/11 x64" FontSize="11" Foreground="#555562"/>
        </Grid>
    </Grid>
</Window>
